{
  "name": "@studyforge/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./courses": {
      "types": "./lib/types/courses.d.ts",
      "default": "./lib/types/courses.js"
    },
    "./*": {
      "types": "./lib/types/*.d.ts",
      "default": "./lib/types/*.js"
    },
    "./probe": {
      "types": "./lib/types/probe.d.ts",
      "default": "./lib/types/probe.js"
    },
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    }
  },
  "files": [
    "lib/types"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.5-rc.2",
    "zod": "4.6.2"
  }
}
