{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "tsBuildInfoFile": "lib/build.tsbuildinfo",
    "types": [
      "node"
    ],
    "lib": [
      "ES2023", "ES2025.Float16", "DOM", "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    { "path": "../domain" },
    {
      "path": "../contracts"
    }
  ]
}
