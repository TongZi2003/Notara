{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "tsBuildInfoFile": "lib/build.tsbuildinfo",
    "types": [
      "react"
    ],
    "lib": [
      "ES2023",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx"
  },
  "references": [{ "path": "../contracts" }],
  "include": [
    "src/**/*"
  ]
}
