# Isolated runtime, credentials, test output, machine-local state.
.runtime/
node_modules/
*.tsbuildinfo

# Test / build output
dist/
lib/
test-results/
playwright-report/
coverage/

# Machine-local DSH homes and auth material (never committed)
.dsh/
.dsh-home/
.trial/
*.local.env
.env
.env.*
**/auth.json
**/credentials.json

# Session scratch (debug scripts, stray logs); evidence logs under docs/ stay tracked
/zz-*.mts
/*.log
/examples/native-vault/teaching/
/examples/native-vault/fonts/
/examples/native-vault/lazy/

# Local brainstorming mockups
.superpowers/

# Local design, research and acceptance material stays outside the public release.
/docs/*
!/docs/install.md
!/docs/first-lesson.md
!/docs/runtime/
/docs/runtime/*
!/docs/runtime/plugins.md
!/docs/runtime/upstream-lock.json
!/docs/runtime/update-contract.json
