!/docs/runtime/windows-native-vault.md
!/docs/releases/
/docs/releases/*
!/docs/releases/native-vault-0.21.1.md
!/docs/releases/native-vault-0.22.0.md
!/docs/releases/native-vault-0.22.1.md

# Retired workbench-only build/test configurations (kept locally).
/tsconfig.math-plugin.json
/tsconfig.plugin-sources.json
/vitest.live.config.ts
