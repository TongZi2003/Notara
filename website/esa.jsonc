// Fallback copy: only used if the ESA console 根目录 is set to /website and
// esa.jsonc is resolved relative to it. The canonical config is /esa.jsonc at
// the repository root (commands there run from the repo root via --prefix).
{
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "assets": {
    "directory": "./dist",
    "notFoundStrategy": "404Page"
  }
}
